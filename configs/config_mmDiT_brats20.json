{
    "model": {
        "type": "image_transformer_v2",
        "input_channels": 7,
        "output_channels": 3,
        "input_size": [192, 192],
        "patch_size": [2, 2],
        "depths": [2, 2, 2],
        "widths": [128, 256, 384],
        "self_attns": [
            {"type": "neighborhood", "d_head": 64, "kernel_size": 9},
            {"type": "neighborhood", "d_head": 64, "kernel_size": 13},
            {"type": "global", "d_head": 64}
        ],
        "dropout_rate": [0.0, 0.0, 0.1],
        "mapping_depth": 1,
        "mapping_width": 256,
        "mapping_d_ff": 768,
        "mapping_dropout": 0.1
    },
    "flow": {
        "eps": 1e-3,
        "time_sampling": "uniform",
        "logit_normal_m": 0.0,
        "logit_normal_s": 1.0
    },
    "sampling": {
        "method": "euler",
        "euler_steps": 100,
        "rk45_atol": 1e-5,
        "rk45_rtol": 1e-5
    },
    "dataset": {
        "data_path": "./data/brats20/BraTS2020_TrainingData/MICCAI_BraTS2020_TrainingData",
        "splits": {"train": 0.7, "val": 0.1, "test": 0.2},
        "slice_range": [30, 135],
        "image_size": [192, 192]
    },
    "optimizer": {
        "type": "adamw",
        "lr": 1e-4,
        "betas": [0.9, 0.95],
        "eps": 1e-8,
        "weight_decay": 1e-4
    },
    "lr_sched": {
        "type": "cosine",
        "warmup": 0.01
    },
    "ema": {
        "decay": 0.9999
    },
    "training": {
        "batch_size": 32,
        "grad_accum_steps": 1,
        "max_steps": 500000,
        "grad_clip_norm": 1.0,
        "save_every": 15000,
        "eval_every": 15000,
        "demo_every": 99999999
    }
}
