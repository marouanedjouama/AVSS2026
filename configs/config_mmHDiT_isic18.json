{
    "model": {
        "type": "image_transformer_dualstream",
        "input_channels": 4,
        "output_channels": 1,
        "input_size": [256, 256],
        "patch_size": [4, 4],
        "depths": [2, 2, 4],
        "widths": [256, 512, 768],
        "self_attns": [
            {"type": "neighborhood_dualstream", "d_head": 32, "kernel_size": 7},
            {"type": "neighborhood_dualstream", "d_head": 32, "kernel_size": 7},
            {"type": "global_dualstream", "d_head": 32}
        ],
        "dropout_rate": [0.0, 0.1, 0.1],
        "mapping_depth": 1,
        "mapping_width": 256,
        "mapping_d_ff": 768,
        "mapping_dropout": 0.1,
        "use_expert_adaln": false,
        "_comment_gqa": "To enable GQA, add 'n_kv_heads' to self_attns entries. E.g., n_kv_heads=4 with d_head=32 and width=256 gives 8 Q heads and 4 KV heads (GQA ratio 2:1). Omit n_kv_heads for standard MHA."
    },
    "flow": {
        "eps": 1e-3,
        "time_sampling": "uniform",
        "logit_normal_m": 0.0,
        "logit_normal_s": 1.0
    },
    "sampling": {
        "method": "euler",
        "euler_steps": 100,
        "rk45_atol": 1e-5,
        "rk45_rtol": 1e-5
    },
    "dataset": {
        "data_path": "/home/sbekhouche/Projects/marouane/MIUA2026/datasets/ISIC_data",
        "image_size": 256
    },
    "optimizer": {
        "type": "adamw",
        "lr": 1e-4,
        "betas": [0.9, 0.95],
        "eps": 1e-8,
        "weight_decay": 1e-3
    },
    "lr_sched": {
        "type": "constant",
        "warmup": 0.04
    },
    "ema": {
        "decay": 0.9999
    },
    "training": {
        "batch_size": 2,
        "grad_accum_steps": 1,
        "max_steps": 300000,
        "grad_clip_norm": 1.0,
        "save_every": 10000,
        "eval_every": 10000,
        "demo_every": 10000
    }
}
